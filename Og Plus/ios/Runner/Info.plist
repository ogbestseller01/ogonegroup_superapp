
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

    <!-- App Identity -->
    <key>CFBundleDevelopmentRegion</key>
    <string>$(DEVELOPMENT_LANGUAGE)</string>

    <key>CFBundleDisplayName</key>
    <string>Og Plus</string>

    <key>CFBundleName</key>
    <string>Og Plus</string>

    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>

    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>

    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>

    <key>CFBundlePackageType</key>
    <string>APPL</string>

    <key>CFBundleShortVersionString</key>
    <string>$(FLUTTER_BUILD_NAME)</string>

    <key>CFBundleVersion</key>
    <string>$(FLUTTER_BUILD_NUMBER)</string>

    <key>CFBundleSignature</key>
    <string>????</string>

    <!-- iOS Compatibility -->
    <key>CADisableMinimumFrameDurationOnPhone</key>
    <true/>

    <key>LSRequiresIPhoneOS</key>
    <true/>

    <key>UIApplicationSupportsIndirectInputEvents</key>
    <true/>

    <!-- URL Schemes -->
    <key>LSApplicationQueriesSchemes</key>
    <array>
        <string>tel</string>
        <string>sms</string>
        <string>mailto</string>
        <string>https</string>
        <string>http</string>
    </array>

    <!-- Firebase -->
    <key>FirebaseAppDelegateProxyEnabled</key>
    <true/>

    <!-- Network Security -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <false/>

        <key>NSExceptionDomains</key>
        <dict>
            <key>api.ogonegroup.com</key>
            <dict>
                <key>NSExceptionAllowsInsecureHTTPLoads</key>
                <true/>

                <key>NSIncludesSubdomains</key>
                <true/>
            </dict>
        </dict>
    </dict>

    <!-- Bluetooth Permissions -->
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>Og Plus uses Bluetooth when you choose to connect to nearby devices and services.</string>

    <key>NSBluetoothPeripheralUsageDescription</key>
    <string>Og Plus uses Bluetooth when you choose to connect to nearby peripherals.</string>

    <!-- Camera -->
    <key>NSCameraUsageDescription</key>
    <string>Og Plus needs camera access to scan QR codes and capture images for services you request.</string>

    <!-- Contacts -->
    <key>NSContactsUsageDescription</key>
    <string>Og Plus may access your contacts when you choose to invite or share a service with someone.</string>

    <!-- Face ID -->
    <key>NSFaceIDUsageDescription</key>
    <string>Og Plus uses Face ID to securely authenticate you and protect your account.</string>

    <!-- Location -->
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>Og Plus may use your location in the background to keep nearby services up to date when this feature is enabled.</string>

    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Og Plus uses your location to show nearby fundis and services around you.</string>

    <!-- Microphone -->
    <key>NSMicrophoneUsageDescription</key>
    <string>Og Plus needs microphone access when you choose to record voice notes and audio messages.</string>

    <!-- Photos -->
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>Og Plus needs permission to save images, documents and QR codes to your photo library.</string>

    <key>NSPhotoLibraryUsageDescription</key>
    <string>Og Plus needs access to your photos when you choose to attach images to requests and posts.</string>

    <!-- Tracking -->
    <key>NSUserTrackingUsageDescription</key>
    <string>Og Plus may use tracking information, with your permission, to improve relevant content and services.</string>

    <!-- App Scenes -->
    <key>UIApplicationSceneManifest</key>
    <dict>
        <key>UIApplicationSupportsMultipleScenes</key>
        <false/>

        <key>UISceneConfigurations</key>
        <dict>
            <key>UIWindowSceneSessionRoleApplication</key>
            <array>
                <dict>
                    <key>UISceneClassName</key>
                    <string>UIWindowScene</string>

                    <key>UISceneConfigurationName</key>
                    <string>flutter</string>

                    <key>UISceneDelegateClassName</key>
                    <string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>

                    <key>UISceneStoryboardFile</key>
                    <string>Main</string>
                </dict>
            </array>
        </dict>
    </dict>

    <!-- Background Notifications -->
    <key>UIBackgroundModes</key>
    <array>
        <string>remote-notification</string>
    </array>

    <!-- Launch Screen -->
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>

    <key>UIMainStoryboardFile</key>
    <string>Main</string>

    <!-- iPhone Orientation -->
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
    </array>

    <!-- iPad Orientation -->
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
    </array>

</dict>
</plist>
